# Copiez ce fichier sous backup.env, puis adaptez les noms a votre compose.yml.
# backup.env ne doit pas etre versionne s'il contient des informations sensibles.

COMPOSE_FILE=/opt/cfdt/umap/compose.yml
ENV_FILE=/opt/cfdt/umap/.env
POSTGRES_SERVICE=db
POSTGRES_DB=umap
POSTGRES_USER=umap
UMAP_SERVICE=umap
BACKUP_ROOT=/opt/cfdt/backups/umap
RETENTION_DAYS=30
DATA_PATHS="config custom"

# Par defaut, .env n'est ni sauvegarde ni restaure.
BACKUP_ENV_FILE=0
RESTORE_ENV_FILE=0
RESTORE_FILES=1
